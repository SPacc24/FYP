project/storage/cache/
project/storage/cisa_kev/
project/storage/mitre_cve/
project/storage/msrc/
project/storage/msrc_windows/
project/storage/nvd_cache/*
project/storage/results/*
project/storage/scans/*
project/storage/missions/*
project/storage/reports/
project/storage/smb_evidence/
project/storage/logs/
# Re-include the placeholder files so empty dirs are preserved in the repo.
!project/storage/nvd_cache/.gitkeep
!project/storage/results/.gitkeep
!project/storage/scans/.gitkeep
!project/storage/missions/.gitkeep
