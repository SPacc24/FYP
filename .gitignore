# ---- OS / editor junk ----
.DS_Store
**/.DS_Store
*.swp

# ---- Python ----
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.venv/
**/.venv/
venv/

# ---- Secrets / local config (NEVER commit) ----
.env
**/.env
project/lab_credentials.txt

# ---- Generated scan data, caches, and intel feeds (large / sensitive) ----
