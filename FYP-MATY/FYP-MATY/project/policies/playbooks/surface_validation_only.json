{
  "id": "surface_validation_only",
  "title": "Surface validation only (safe)",
  "version": 1,
  "goal": "Inventory authorised Ethernet surface and queue only non-destructive catalog validation modules. No impact gate.",
  "summary": "Safe-only closed loop for demos without exploitation.",
  "risk_posture_default": "safe-only",
  "stages": [
    {
      "id": "mission_brief",
      "title": "Mission brief",
      "order": 0,
      "description": "Safe-only posture locked.",
      "auto_advance": true
    },
    {
      "id": "surface_lock",
      "title": "Surface lock",
      "order": 1,
      "description": "Ingest scan into attack graph.",
      "auto_advance": true,
      "actions": [
        {
          "id": "ingest_scan",
          "kind": "ingest_scan",
          "title": "Ingest scan evidence",
          "risk": "info",
          "auto": true,
          "requires_approval": false
        },
        {
          "id": "build_graph",
          "kind": "build_attack_graph",
          "title": "Build attack graph",
          "risk": "info",
          "auto": true,
          "requires_approval": false
        }
      ]
    },
    {
      "id": "hypothesis",
      "title": "Hypothesis",
      "order": 2,
      "description": "Catalog-only safe modules.",
      "auto_advance": true,
      "actions": [
        {
          "id": "catalog_hypotheses",
          "kind": "propose_catalog_actions",
          "title": "Catalog hypothesis generation",
          "risk": "info",
          "auto": true,
          "requires_approval": false,
          "filter": {
            "include_module_types": ["auxiliary"],
            "include_web_profiles": false,
            "include_lateral": false,
            "include_research_unknown": true
          }
        }
      ]
    },
    {
      "id": "safe_validation",
      "title": "Safe validation storm",
      "order": 3,
      "description": "Queue auxiliary catalog scanners only.",
      "auto_advance": true,
      "actions": [
        {
          "id": "queue_safe_aux",
          "kind": "queue_actions",
          "title": "Queue safe auxiliary modules",
          "risk": "medium",
          "auto": true,
          "requires_approval": false,
          "filter": {
            "module_types": ["auxiliary"],
            "risks": ["low", "medium", "high"],
            "require_approval": false
          }
        }
      ]
    },
    {
      "id": "branch_brain",
      "title": "Branch brain",
      "order": 4,
      "description": "Record unknown surfaces and suppressed paths.",
      "auto_advance": true,
      "actions": [
        {
          "id": "evaluate_branches",
          "kind": "evaluate_branches",
          "title": "Evaluate branch rules",
          "risk": "info",
          "auto": true,
          "requires_approval": false
        }
      ]
    },
    {
      "id": "mission_debrief",
      "title": "Mission debrief",
      "order": 5,
      "description": "Safe-only debrief — no impact claims.",
      "auto_advance": true,
      "actions": [
        {
          "id": "compile_debrief",
          "kind": "compile_debrief",
          "title": "Compile mission debrief",
          "risk": "info",
          "auto": true,
          "requires_approval": false
        }
      ]
    }
  ],
  "branches": [
    {
      "id": "unknown_surface",
      "when": {"flag": "unknown_surface_present"},
      "set_flags": ["research_queue_active"],
      "message": "Unknown services queued for research (safe probes only).",
      "priority": 5
    },
    {
      "id": "ms17_patched_or_absent",
      "when": {
        "all": [
          {"flag": "smb_present"},
          {"not": {"flag": "ms17_cve_evidence"}}
        ]
      },
      "set_flags": ["ms17_not_exploitable", "branch_ms17_suppressed"],
      "message": "SMB seen; MS17-010 not evidenced — no exploit proposed under safe-only posture.",
      "priority": 15
    }
  ],
  "evidence_detectors": [
    {
      "flag": "http_present",
      "match": {
        "ports": [80, 8000, 8008, 8080],
        "services": ["http", "http-alt", "http-proxy"]
      }
    },
    {
      "flag": "smb_present",
      "match": {
        "ports": [139, 445],
        "services": ["smb", "microsoft-ds", "netbios-ssn"]
      }
    },
    {
      "flag": "ms17_cve_evidence",
      "match": {
        "cves": [
          "CVE-2017-0143",
          "CVE-2017-0144",
          "CVE-2017-0145",
          "CVE-2017-0146",
          "CVE-2017-0148",
          "MS17-010"
        ]
      }
    }
  ],
  "pivot_segments": [],
  "blue_team_timeline_templates": [
    {
      "stage": "surface_lock",
      "alert": "Authorised Ethernet inventory scan",
      "severity": "low",
      "response": "Logged"
    },
    {
      "stage": "safe_validation",
      "alert": "Non-destructive validation probes",
      "severity": "medium",
      "response": "Correlate with assets"
    }
  ]
}
