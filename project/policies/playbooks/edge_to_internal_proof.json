{
  "id": "edge_to_internal_proof",
  "title": "Edge to internal impact proof",
  "version": 1,
  "goal": "From authorised edge evidence, auto-validate safe exposures, branch when celebrity exploits are patched, unlock high-risk impact only with proof plan + operator approval, then expand via pivot.",
  "summary": "Closed-loop mission: surface → safe validation → branch brain → impact gate → pivot expand → debrief.",
  "risk_posture_default": "validate",
  "stages": [
    {
      "id": "mission_brief",
      "title": "Mission brief",
      "order": 0,
      "description": "Scope and goal locked. Evidence-closed-loop orchestrator armed.",
      "auto_advance": true
    },
    {
      "id": "surface_lock",
      "title": "Surface lock",
      "order": 1,
      "description": "Ingest Ethernet/LAN-authorised scan evidence into the attack graph.",
      "auto_advance": true,
      "actions": [
        {
          "id": "ingest_scan",
          "kind": "ingest_scan",
          "title": "Ingest scan evidence",
          "risk": "info",
          "auto": true,
          "requires_approval": false
        },
        {
          "id": "build_graph",
          "kind": "build_attack_graph",
          "title": "Build attack graph",
          "risk": "info",
          "auto": true,
          "requires_approval": false
        }
      ]
    },
    {
      "id": "hypothesis",
      "title": "Hypothesis",
      "order": 2,
      "description": "Catalog matches known modules; unknown surfaces enter research queue. AI may rank but never invents module paths.",
      "auto_advance": true,
      "actions": [
        {
          "id": "catalog_hypotheses",
          "kind": "propose_catalog_actions",
          "title": "Catalog hypothesis generation",
          "risk": "info",
          "auto": true,
          "requires_approval": false,
          "filter": {
            "include_module_types": ["auxiliary", "exploit"],
            "include_web_profiles": true,
            "include_lateral": true,
            "include_research_unknown": true
          }
        }
      ]
    },
    {
      "id": "safe_validation",
      "title": "Safe validation storm",
      "order": 3,
      "description": "Automatically queue low/medium risk catalog scanners and safe MS17/BlueKeep checks. No shells.",
      "auto_advance": true,
      "actions": [
        {
          "id": "queue_safe_aux",
          "kind": "queue_actions",
          "title": "Queue safe auxiliary modules",
          "risk": "medium",
          "auto": true,
          "requires_approval": false,
          "filter": {
            "module_types": ["auxiliary"],
            "risks": ["low", "medium", "high"],
            "require_approval": false
          }
        }
      ]
    },
    {
      "id": "branch_brain",
      "title": "Branch brain",
      "order": 4,
      "description": "Evaluate evidence flags. Patched celebrity vulns suppress exploits and unlock alternate paths.",
      "auto_advance": true,
      "actions": [
        {
          "id": "evaluate_branches",
          "kind": "evaluate_branches",
          "title": "Evaluate branch rules",
          "risk": "info",
          "auto": true,
          "requires_approval": false
        }
      ]
    },
    {
      "id": "impact_gate",
      "title": "Impact gate",
      "order": 5,
      "description": "High-risk catalog exploits and web footholds wait for human approval + proof plan.",
      "auto_advance": false,
      "requires_unlock_flag": "impact_path_available",
      "actions": [
        {
          "id": "queue_high_risk",
          "kind": "queue_actions",
          "title": "Queue high-risk impact actions",
          "risk": "critical",
          "auto": false,
          "requires_approval": true,
          "filter": {
            "module_types": ["exploit"],
            "risks": ["high", "critical"],
            "include_web_profiles": true,
            "require_approval": true
          }
        }
      ]
    },
    {
      "id": "alternate_lateral",
      "title": "Alternate lateral (non-EB)",
      "order": 6,
      "description": "When EternalBlue-class paths are suppressed, plan catalog lateral techniques (enum, signing, creds-oriented).",
      "auto_advance": true,
      "requires_unlock_flag": "alternate_lateral_enabled",
      "actions": [
        {
          "id": "queue_lateral_alts",
          "kind": "queue_lateral",
          "title": "Queue lateral alternatives",
          "risk": "medium",
          "auto": true,
          "requires_approval": false,
          "filter": {
            "exclude_keys": ["lateral_eternalblue"]
          }
        }
      ]
    },
    {
      "id": "pivot_expand",
      "title": "Pivot expand",
      "order": 7,
      "description": "After foothold proof, expand into internal Ethernet segments (USERS/ADMIN VLANs). Direct path must be blocked for true pivot narrative.",
      "auto_advance": false,
      "requires_unlock_flag": "foothold_proved",
      "actions": [
        {
          "id": "recommend_pivot",
          "kind": "recommend_pivot",
          "title": "Recommend pivot segments",
          "risk": "high",
          "auto": false,
          "requires_approval": true,
          "filter": {
            "segments_from_policy": true
          }
        }
      ]
    },
    {
      "id": "mission_debrief",
      "title": "Mission debrief",
      "order": 8,
      "description": "Compile proved findings, suppressed exploits, research queue, MITRE chain, and blue-team timeline.",
      "auto_advance": true,
      "actions": [
        {
          "id": "compile_debrief",
          "kind": "compile_debrief",
          "title": "Compile mission debrief",
          "risk": "info",
          "auto": true,
          "requires_approval": false
        }
      ]
    }
  ],
  "branches": [
    {
      "id": "web_foothold_candidate",
      "when": {
        "any": [
          {"flag": "http_present"},
          {"flag": "web_profile_matched"}
        ]
      },
      "set_flags": ["impact_path_available", "web_path_ready"],
      "message": "Web attack surface matched catalog profile — impact gate unlocked for approved foothold.",
      "priority": 10
    },
    {
      "id": "ms17_open",
      "when": {
        "all": [
          {"flag": "smb_present"},
          {"any": [
            {"flag": "ms17_cve_evidence"},
            {"flag": "ms17_vulnerable"}
          ]}
        ]
      },
      "set_flags": ["impact_path_available", "ms17_path_ready", "branch_ms17_open"],
      "message": "SMB + MS17-010 class evidence present — EternalBlue-class exploit may be proposed after operator approval.",
      "priority": 20
    },
    {
      "id": "ms17_patched_or_absent",
      "when": {
        "all": [
          {"flag": "smb_present"},
          {"not": {"flag": "ms17_vulnerable"}},
          {"not": {"flag": "ms17_cve_evidence"}}
        ]
      },
      "set_flags": ["alternate_lateral_enabled", "branch_ms17_suppressed", "ms17_not_exploitable"],
      "message": "SMB present but MS17-010 not evidenced — exploit suppressed. Alternate lateral planning enabled (professional non-exploit outcome).",
      "priority": 15
    },
    {
      "id": "unknown_surface",
      "when": {"flag": "unknown_surface_present"},
      "set_flags": ["research_queue_active"],
      "message": "Uncatalogued services entered zero-day readiness / research queue — safe probes only, no invented exploits.",
      "priority": 5
    },
    {
      "id": "foothold_recorded",
      "when": {"flag": "foothold_proved"},
      "set_flags": ["foothold_proved", "pivot_ready"],
      "message": "Foothold proof recorded — pivot expansion may proceed under approval.",
      "priority": 30
    }
  ],
  "evidence_detectors": [
    {
      "flag": "http_present",
      "match": {
        "ports": [80, 8000, 8008, 8080],
        "services": ["http", "http-alt", "http-proxy"]
      }
    },
    {
      "flag": "https_present",
      "match": {
        "ports": [443, 8443],
        "services": ["https", "ssl/http"]
      }
    },
    {
      "flag": "smb_present",
      "match": {
        "ports": [139, 445],
        "services": ["smb", "microsoft-ds", "netbios-ssn"]
      }
    },
    {
      "flag": "ssh_present",
      "match": {
        "ports": [22],
        "services": ["ssh"]
      }
    },
    {
      "flag": "rdp_present",
      "match": {
        "ports": [3389],
        "services": ["rdp", "ms-wbt-server"]
      }
    },
    {
      "flag": "ms17_cve_evidence",
      "match": {
        "cves": [
          "CVE-2017-0143",
          "CVE-2017-0144",
          "CVE-2017-0145",
          "CVE-2017-0146",
          "CVE-2017-0148",
          "MS17-010"
        ]
      }
    },
    {
      "flag": "bluekeep_cve_evidence",
      "match": {
        "cves": ["CVE-2019-0708"]
      }
    }
  ],
  "pivot_segments": [
    {
      "id": "users_vlan",
      "cidr": "10.10.20.0/24",
      "label": "USERS VLAN"
    },
    {
      "id": "admin_vlan",
      "cidr": "10.10.10.0/24",
      "label": "ADMIN VLAN"
    }
  ],
  "blue_team_timeline_templates": [
    {
      "stage": "surface_lock",
      "alert": "Ethernet segment scan / ARP-Nmap inventory observed",
      "severity": "medium",
      "response": "Logged — confirm authorised scope"
    },
    {
      "stage": "safe_validation",
      "alert": "Auxiliary service validation probes (SMB/HTTP checks)",
      "severity": "medium",
      "response": "Correlate with asset inventory"
    },
    {
      "stage": "impact_gate",
      "alert": "High-risk action approved by red operator",
      "severity": "high",
      "response": "Heighten monitoring; prepare isolation"
    },
    {
      "stage": "pivot_expand",
      "alert": "Internal VLAN scan via pivot path",
      "severity": "high",
      "response": "Isolate affected VLAN; hunt lateral"
    }
  ]
}
