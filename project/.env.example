# Copy to .env only when configuring manually. The installer normally creates
# project/.env with unique secrets and mode 0600.
DEBUG=false
APP_HOST=127.0.0.1
PORT=5000
SECRET_KEY=replace-with-at-least-32-random-characters
OPERATOR_TOKEN=replace-with-at-least-32-random-characters
ALLOW_INSECURE_OPERATOR_ACCESS=0

# CVE sources
NVD_ENRICHMENT_ENABLED=1
NVD_CPE_RESOLUTION_ENABLED=0
NVD_API_KEY=
NVD_REQUEST_DELAY_SECONDS=6.5
NVD_REQUEST_TIMEOUT_SECONDS=20
NVD_CACHE_TTL_SECONDS=604800

# Optional directory containing operator-exported read-only Windows inventory
# JSON. The scanner never accepts or stores Windows credentials.
WINDOWS_INVENTORY_DIR=
MSRC_REQUEST_TIMEOUT_SECONDS=45
# Installer coverage window for the official Microsoft Windows advisory index.
MSRC_HISTORY_YEARS=15

# Database
MYSQL_HOST=127.0.0.1
MYSQL_USER=autopentest
MYSQL_PASS=
MYSQL_DB=autopentest

# All validation, execution, credential, and exploitation features are off.
ENABLE_CALDERA_EXECUTION=0
ENABLE_METASPLOIT=0
ENABLE_METASPLOIT_EXPLOITS=0
ENABLE_WEB_VALIDATION=0
ENABLE_WEB_EXPLOITATION=0
ENABLE_SMB_EXPLOITATION=0
ENABLE_HYDRA=0
ENABLE_LAB_CREDENTIAL_AUDIT=0
PROOF_OF_ACCESS_ENABLED=false
