flowchart TD
    A["Operator submits TARGET_INPUT and profile"] --> B["normalise_scan_options(profile, selected tools)"]
    B --> C{"Recon policy loaded and valid?"}
    C -- "No" --> C1["STOP before target interaction<br/>Expected: failed scan + policy error"]
    C -- "Yes" --> D["Resolve tool conflicts<br/>Explicit disabled wins<br/>Record policy SHA-256"]
    D --> E["expand_target_input(TARGET_INPUT)<br/>Expected: canonical authorized address list"]
    E --> F{"Scope validation passes?"}
    F -- "No" --> F1["STOP<br/>Expected: scope rejection evidence"]
    F -- "Yes" --> G{"Passive packet inventory enabled and interface approved?"}
    G -- "Yes" --> G1["Command: tshark -i INTERFACE -a duration:SECONDS -Y (POLICY_FILTER and AUTHORIZED_TARGET_FILTER)<br/>Expected: target-scoped packet hints<br/>No output: retain empty coverage<br/>Error: retain exit status/stderr"]
    G -- "No" --> G2["Record skipped/disabled reason"]
    G1 --> H
    G2 --> H{"Ambient p0f explicitly allowed?"}
    H -- "No" --> H1["Skip p0f because target scoping is unavailable"]
    H -- "Yes" --> H2["Command: timeout SECONDS p0f -i INTERFACE -p<br/>Expected: passive OS hints<br/>No output/error: explicit coverage state"]
    H1 --> I
    H2 --> I{"Single-target passive-first posture?"}
    I -- "Yes" --> I1["No host sweep<br/>Expected: scoped target accepted for -Pn checks"]
    I -- "No" --> I2["Command: nmap -sn -oX OUTPUT AUTHORIZED_TARGETS<br/>Expected: up-host XML<br/>No hosts: empty status<br/>Parser/command error: warning or failure evidence"]
    I1 --> J
    I2 --> J{"Infrastructure posture observed?"}
    J -- "Yes" --> J1["Command: nmap -sS -p POLICY_MANAGEMENT_PORTS --open POLICY_TIMING -oX OUTPUT TARGET<br/>Expected: management-port XML"]
    J -- "No" --> J2["For each policy micro-batch:<br/>nmap POLICY_OPTIONS -p POLICY_PORTS -oX OUTPUT TARGET<br/>Expected: open/closed/filtered XML"]
    J2 --> J3{"ACL/retransmission stop condition?"}
    J3 -- "Yes" --> J4["Pause additional batches<br/>Retain corroborated ACL evidence"]
    J3 -- "No" --> J5["Continue next policy batch with bounded jitter"]
    J5 --> J2
    J4 --> K
    J1 --> K
    J2 --> K{"Targeted expansion ports remain and policy allows?"}
    K -- "Yes" --> K1["Command: nmap -sS -p POLICY_EXPANSION_PORTS --open POLICY_TIMING -oX OUTPUT TARGET<br/>Expected: additional open-port XML"]
    K -- "No" --> L
    K1 --> L["Record exact TCP requested/open coverage<br/>Record full sweep = false"]
    L --> M{"Service fingerprint enabled and ACL permits?"}
    M -- "Yes" --> M1["Command: nmap -sV --version-intensity 0 --script banner -p OBSERVED_PORTS POLICY_TIMING -oX OUTPUT TARGET<br/>Expected: captured product/version/CPE/banner XML"]
    M -- "No" --> M2["Record skipped reason and evidence gap"]
    M1 --> N
    M2 --> N{"Targeted UDP enabled?"}
    N -- "Yes" --> N1["Command: nmap -sU -p POLICY_UDP_PORTS --open -T2 --max-retries 1 -oX OUTPUT TARGET<br/>Expected: UDP service XML"]
    N -- "No" --> N2["Record UDP disabled/deferred"]
    N1 --> O
    N2 --> O["Build observed service surfaces only"]
    O --> P{"Observed HTTP surface?"}
    P -- "Yes" --> P1["Command: httpx -json -title -tech-detect -status-code -server -follow-redirects POLICY_RATE_OPTIONS -u OBSERVED_URL<br/>Expected: JSONL status/title/technology/server"]
    P1 --> P2["Fallback/validation: policy-limited curl or native HTTP request<br/>2xx/3xx = transport and success<br/>401/403 = retained only with relevant context<br/>404/5xx/transport error = not evidence"]
    P -- "No" --> Q
    P2 --> Q["Run only enabled, surface-triggered protocol collectors<br/>Commands use observed host/port and policy values<br/>No brute force, credentials, writes, or exploitation"]
    Q --> R["Parse every command output<br/>Expected output: structured evidence<br/>Empty output: STATUS_EMPTY + gap<br/>Nonzero/timeout/parser error: STATUS_FAILED/WARN + stderr/output reference"]
    R --> S["Fingerprint consensus<br/>Inputs: captured Nmap + HTTP + TLS + SMB + SSH/native evidence"]
    S --> T{"Contradiction-free, version present, confidence at least threshold?"}
    T -- "No" --> T1["Skip CVE lookup<br/>Diagnostic: confidence/version/contradiction reason"]
    T -- "Yes" --> U{"Official CVE index available?"}
    U -- "No" --> U1["No CVE conclusion<br/>Diagnostic: index unavailable + rebuild command"]
    U -- "Yes" --> V["Derive identity only from observed product/service/CPE<br/>Reviewed alias or exact dynamic identity<br/>No port-to-CVE or target-to-CVE rule"]
    V --> W["Stream official index records<br/>Reject non-official source and product mismatch<br/>Malformed row = degraded diagnostic"]
    W --> X{"Exact normalized CPE version match?"}
    X -- "Yes" --> Y["Retain source CVE record and match basis"]
    X -- "No" --> Z{"Exact product plus exact/bounded affected version match?"}
    Z -- "Yes" --> Y
    Z -- "No" --> Z1["Reject record; do not emit CVE"]
    Y --> AA["Classify context<br/>Confirmed or candidate needing validation<br/>Deduplicate without result cap"]
    Z1 --> AB
    T1 --> AB
    U1 --> AB
    AA --> AB["Publish scanner-canonical-v1 contract<br/>confirmed + candidates + diagnostics"]
    AB --> AC["Sanitize downstream mapping<br/>Remove guessed CVE IDs/links<br/>Inject canonical records by observed host/port only"]
    AC --> AD["Assemble JSON/PDF evidence package<br/>Policy hash + exact coverage + commands/status + errors + limitations"]
    AD --> AE{"Report generation succeeds?"}
    AE -- "Yes" --> AF["Expected: paginated report and handoff with evidence references"]
    AE -- "No" --> AG["Use minimal PDF fallback or retain report failure<br/>Never manufacture missing evidence"]
