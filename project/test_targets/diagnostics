<?php
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['host'])) {
    $host = $_POST['host'];
    echo "<pre>";
    system("ping -c 1 " . $host);
    echo "</pre>";
} else {
    echo '<form method="POST">';
    echo '<input type="text" name="host" placeholder="Enter host">';
    echo '<input type="submit" value="Ping">';
    echo '</form>';
}
?>
